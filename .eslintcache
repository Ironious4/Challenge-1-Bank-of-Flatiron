","messages":"29","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"18"},{"filePath":"30","messages":"31","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"18"},"C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\index.js",[],["32","33"],"C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\components\\App.js",[],"C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\components\\AccountContainer.js",["34"],"import React, {useState, useEffect} from 'react';\r\nimport TransactionsList from './TransactionsList';\r\nimport Search from './Search';\r\nimport AddTransactionForm from './AddTransactionForm';\r\n\r\n\r\nfunction AccountContainer() {\r\n  const [transactions, setTransactions]=useState([]);\r\n  const[search, setSearch]=useState('');\r\n \r\n  useEffect(() => {\r\n    fetch('http://localhost:8001/transactions')\r\n    .then(response=>response.json())\r\n    .then(data=>setTransactions(data))\r\n  }, [])\r\n\r\n  function searchFunction(event){\r\n   setSearch(event.target.value);\r\n   }\r\n  const filterTransactions=transactions.filter((item)=> {\r\n    if(item.category===search) {\r\n      return item\r\n    }\r\n    else if(search==='') {\r\n      return true;\r\n    }\r\n  })\r\n  \r\n\r\n\r\n\r\n\r\n  return (\r\n    <div>\r\n      <Search searchFn={searchFunction}/>\r\n      <AddTransactionForm/>\r\n      <TransactionsList items={filterTransactions}/>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default AccountContainer;","C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\components\\AddTransactionForm.js",[],"C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\components\\Search.js",[],"C:\\Users\\Administrator\\Desktop\\Challenge-1-Bank-of-Flatiron\\src\\components\\TransactionsList.js",[],"C:\\Users\\Administrator\\Desktop\\Chal